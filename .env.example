# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=madanibot
MADANI_BIND_ADDRESS=127.0.0.1
MADANI_HTTP_PORT=8080
# Leave empty to use http://localhost:${MADANI_HTTP_PORT:-8080}.
MADANI_PUBLIC_URL=
# Leave empty to inherit MADANI_PUBLIC_URL.
MADANI_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set MADANI_PUBLIC_URL to https:// followed by the same hostname.
# Requires MADANI_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
MADANI_HTTPS_HOST=
MADANI_BASE_IMAGE=ghcr.io/madanibotai/madanibot:latest
MADANI_LOCAL_IMAGE=madanibot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
MADANI_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
MADANI_DATA_EXTERNAL=false
