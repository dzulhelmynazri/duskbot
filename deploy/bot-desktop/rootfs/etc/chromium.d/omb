# sourced by /usr/bin/chromium for every launch, from the dock, the terminal or Cua Driver.
# no sandbox of its own: it needs user namespaces this container's seccomp profile refuses; the container is the boundary.
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --user-data-dir=${MADANI_CHROMIUM_PROFILE:-$HOME/.config/chromium} --remote-debugging-port=${MADANI_CDP_PORT:-9222} --remote-debugging-address=127.0.0.1 --force-dark-mode --password-store=basic --no-first-run --hide-crash-restore-bubble --no-default-browser-check --disable-dev-shm-usage --disable-features=Translate,MediaRouter,DialMediaRouteProvider --window-size=1000,712 --window-position=140,10"
