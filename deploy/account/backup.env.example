# /etc/madani-backup/<set>.env on the vps, root-owned, mode 0600; one file per set, run by madani-backup@<set>.timer.
# every name is described at the top of backup.sh.

# madani bot (/etc/madani-backup/madani.env), every 6 hours (madani-backup@madani.timer.d): both account databases and the waitlist (one dump of mongod-madani), both
# account data folders and the link service's state. preview's sealed test-cloud backups and old link builds stay out.
MADANI_BACKUP_NAME=madani
MADANI_BACKUP_PATHS="/var/lib/madani-account-prod /var/lib/madani-account-preview /root/omb-link-data"
MADANI_BACKUP_EXCLUDE="/var/lib/madani-account-preview/managed-backups/ *.prev /root/omb-link-data/packages/*.tgz /var/lib/madani-account-prod/managed-backups/ omb-home*.tgz*"
MADANI_BACKUP_MONGO_CONFIG=/etc/mongod-madani/backup.yaml
MADANI_BACKUP_RECIPIENT=age1...
MADANI_BACKUP_DEST="oracle-backup:/data r2-backup:madani-backups"
MADANI_BACKUP_KEEP_RUNS=8
MADANI_BACKUP_KEEP_DAYS=7
MADANI_BACKUP_KEEP_WEEKS=4
# the cloud packages (omb-home*.tgz, rebuilt by every release) and the clouds' own backups stay out: about 20 archives of a few MB; r2's 10 GB free tier is shared with make.design's uploads

# make.design, once a day (/etc/madani-backup/make.env): its database only (uploads already live in its own r2 bucket).
# /etc/madani-backup/make-mongo.yaml holds one line, uri: <make's MONGODB_URI>; mongodump only reads.
# MADANI_BACKUP_NAME=make
# MADANI_BACKUP_MONGO_CONFIG=/etc/madani-backup/make-mongo.yaml
