# madani bot account service (apps/dashboard/server, with the managed cloud in apps/cloud-service) on madani.bot: the page at
# /dashboard, the admin at /admin, the API at /v1 and /api, the site (MADANI_SITE_UPSTREAM) at every other path.
# Names and what they do; no values. Copy to a 0600 file outside the repo, fill in, and pass it to deploy with
# --env-file. Never commit the filled copy. Staging (dev.madani.bot) uses its own copy: see docs/LAUNCH.md.
# scripts/account-env-template.test.ts fails when the service reads a name this file does not list.

# --- service ---
# public origin; sets cookie Secure, CORS and the OAuth callback base. https://madani.bot (staging: https://preview.madani.bot)
MADANI_DASHBOARD_PUBLIC_URL=
# listen address; keep loopback, nginx (deployd) proxies to it
MADANI_DASHBOARD_HOST=127.0.0.1
# listen port; deployd writes PORT, the deploy command maps it: MADANI_DASHBOARD_PORT=$PORT
MADANI_DASHBOARD_PORT=
# data folder (accounts, sessions, workspaces, billing, clouds); back it up (deploy/account/backup.sh). e.g. /var/lib/madani-account
MADANI_DASHBOARD_DATA=
# built page folder; defaults to apps/dashboard/dist after pnpm build:dashboard
MADANI_DASHBOARD_STATIC=
# the page's path when it shares its origin with the site: /dashboard (build the page with MADANI_DASHBOARD_BASE=/dashboard/); empty serves it at the root
MADANI_DASHBOARD_PAGE_BASE=
# with a page base: the site's own server on loopback (http://127.0.0.1:<port>); every other path is proxied there
MADANI_SITE_UPSTREAM=
# 1 before launch: the page's routes go to / (the waitlist) except sign-in, /cloud/desktop, /handoff, /claim and a
# cloud's delete link; the API, webhooks, /admin and the site are untouched. empty (launch) serves the whole page.
# while 1 nothing can be bought (web and app checkouts answer checkout_soon); App Review's grant still works
MADANI_PRELAUNCH_WAITLIST_ONLY=
# 1 behind the deployd nginx proxy, so rate limits see the proxy's own X-Forwarded-For entry
MADANI_TRUST_PROXY=1
# production | staging; tags error reports
MADANI_ENVIRONMENT=
# 1 only for local development (console mail, fake providers); never in production
MADANI_DASHBOARD_DEV=
# HMAC secret for CSRF tokens and codes, 32+ characters; if empty the service makes data/auth-secret itself
MADANI_AUTH_SECRET=
# 0 closes new sign-ups (existing accounts still sign in)
MADANI_AUTH_SIGNUP_OPEN=
# App Review's demo account: this one address signs in to the apps with this fixed 8-digit code and no email (normal
# rate limits), and is the only account POST /v1/billing/ops/review may mark (apps/dashboard/scripts/review-account.mjs)
MADANI_REVIEW_EMAIL=
MADANI_REVIEW_CODE=
# sign-in emails an hour across all callers (default 600); past it everyone gets "try again later"
MADANI_AUTH_MAIL_PER_HOUR=
# sign-in emails a day across all callers (default AUTH_LIMITS.mailPerDay); raise it with the brevo plan
MADANI_AUTH_MAIL_PER_DAY=
# where the service writes its trail files (trail-cloud-*); empty writes the trail to the service's output
MADANI_TRAIL_DIR=
# Cloudflare Realtime TURN key (dashboard: Realtime, TURN Server, Create key) for the direct screen path; empty means no TURN
MADANI_CF_TURN_KEY_ID=
MADANI_CF_TURN_KEY_TOKEN=
# coturn beside the link nodes: LINK_TURN_SECRET from the nodes, and their hosts (link.madani.bot,link-in.madani.bot); empty means only Cloudflare
MADANI_TURN_SECRET=
MADANI_TURN_HOSTS=
# where crashes and 500s go: a Sentry-compatible DSN (self-hosted GlitchTip or sentry.io); empty turns reporting off
MADANI_ERROR_DSN=

# --- database (docs/mongodb.md): every account, session, workspace, plan, payment and cloud record lives here ---
# required outside local development; a replica set (transactions): mongodb://madani:<password>@127.0.0.1:29018/madani?authSource=admin&replicaSet=rs-madani
MONGODB_URI=
# database name: madani_prod on madani.bot, madani on preview (one writer lease per database, docs/mongodb.md)
MONGODB_DB=
# the database the site's waitlist lives in (madani), when it is not MONGODB_DB; the admin panel only reads it ("off" shows none)
MADANI_WAITLIST_DB=
# preview only: its admin's analytics pages read madani.bot's (madani_prod) by default, with a switch back to preview's own.
# the URI is the user madani_admin_ro, which has only read on madani_prod; leave both empty on madani.bot
MADANI_ADMIN_ANALYTICS_URI=
MADANI_ADMIN_ANALYTICS_DB=

# --- email (sign-in codes, notices) ---
# codes, receipts and "cloud ready" go through resend (no tracking, so gmail's primary tab), everything else through brevo;
# each falls back to the other at its cap, and resend's failures (429, 5xx, a refused key) go through brevo (auth/mail-router.ts).
# MADANI_MAIL_PROVIDER names the provider that must be configured (brevo or resend)
MADANI_MAIL_PROVIDER=brevo
# Brevo API key (SMTP & API > API keys)
MADANI_BREVO_API_KEY=
# Resend API key, sending access for madani.bot only (open and click tracking off on the domain)
MADANI_RESEND_API_KEY=
# caps this service counts in mongodb (mail_usage): resend defaults to its free tier, 100 a day and 3,000 a month;
# brevo to 300 a day (MADANI_BREVO_DAILY_LIMIT below) and 10,000 a month
MADANI_RESEND_DAILY_LIMIT=
MADANI_RESEND_MONTHLY_LIMIT=
MADANI_BREVO_MONTHLY_LIMIT=
# sender, e.g. madani bot <account@madani.bot> (domain authenticated in Brevo: Brevo code, DKIM, DMARC)
MADANI_MAIL_FROM=
# where mail clients load the email art and fonts (default https://madani.bot/email), the site links in mail (default the public origin), and the postal address in the footer
MADANI_EMAIL_ASSET_BASE=
MADANI_EMAIL_SITE_URL=
MADANI_MAIL_POSTAL_ADDRESS=
# 32+ characters; turns on GET /v1/billing/ops/funnel for the operator; empty removes the route
MADANI_OPS_TOKEN=

# --- the owner's admin panel (/admin) and product analytics ---
# comma-separated account emails allowed into the admin panel; empty lets nobody in
MADANI_ADMIN_EMAILS=
# accounts that get the limited growth admin role (analytics and revenue, read only) without a grant from the panel
MADANI_GROWTH_ADMIN_EMAILS=
# the Brevo contact list the madani.bot waitlist adds to (its numeric id), for the panel's sync check; empty hides it
MADANI_BREVO_WAITLIST_LIST_ID=
# services the health page probes: name=url pairs, comma-separated, e.g. link=https://link.madani.bot/health
MADANI_ADMIN_HEALTH_URLS=
# where the daily MongoDB dumps land; defaults to /root/backups/mongo-madani with MongoDB
MADANI_BACKUP_DIR=

# --- the admin ops page (/admin/ops): spend, health, outliers; every collector without its names is shown as not set up ---
# Cloudflare GraphQL Analytics, read only (Account Analytics: Read): workers requests and cpu, r2 bucket sizes
MADANI_CF_ANALYTICS_TOKEN=
MADANI_CF_ACCOUNT_ID=
# the composio broker's STATS_TOKEN (GET /v1/stats/usage); MADANI_COMPOSIO_BROKER_URL defaults to https://composio.madani.bot
MADANI_COMPOSIO_BROKER_STATS_TOKEN=
MADANI_COMPOSIO_BROKER_URL=
# the link service's LINK_STATS_TOKEN (GET /v1/stats/relay, and the contabo relay card: GET /ops/relay/stats, PUT /ops/relay/limits);
# MADANI_LINK_URL defaults to https://link.madani.bot
MADANI_LINK_STATS_TOKEN=
# the link nodes past the first, "oracle-in=https://link-in.madani.bot,..."
MADANI_LINK_URL=
MADANI_LINK_NODES=
# the link service beside this one on loopback, which serves madani.bot/s/<code> (the own-server install line); empty turns /s/ off
MADANI_LINK_UPSTREAM=
# the cloudflare link relay's OPS_TOKEN secret, for its relay card (GET /ops/relay/stats, PUT /ops/relay/limits);
# MADANI_CF_RELAY_URL defaults to https://relay.madani.bot (preview: https://relay-preview.madani.bot)
MADANI_CF_RELAY_URL=
MADANI_CF_RELAY_OPS_TOKEN=
# 24+ characters; turns on POST /v1/ops/report for deploy/monitor/host-report.mjs (the oracle box); empty removes the route
MADANI_OPS_REPORT_TOKEN=
# alert emails from the ops rules: on in production, off elsewhere unless "on"
MADANI_OPS_ALERTS=
# optional: brevo's daily send cap (default 300; the mail router stops at it too), flat monthly bills ("contabo vps=1500"),
# probe list ("id=name=url,..."), backup sets read from systemd ("madani make"), certificate hosts
MADANI_BREVO_DAILY_LIMIT=
MADANI_OPS_FIXED_CENTS=
MADANI_OPS_PROBES=
MADANI_OPS_BACKUP_SETS=
MADANI_OPS_CERT_HOSTS=
# contabo's dependable upload in Mbit/s (default 120) and its monthly outgoing allowance in TB (default 32)
MADANI_OPS_UPLINK_MBIT=
MADANI_OPS_EGRESS_ALLOWANCE_TB=
# 1 lets the operator end a home package's trial early (always on with the preview billing provider)
MADANI_OPS_END_TRIAL=
# extra origins whose pages send site analytics to /v1/t (the service's own origin is always allowed), e.g. https://madani.bot,https://www.madani.bot
MADANI_TRACK_ORIGINS=
# emails to the admins, production only: all, or any of paid,spike,digest (daily at 08:00 UTC, only with news); empty sends none
MADANI_ADMIN_ALERTS=
# "something's wrong" emails (docs/LAUNCH.md, alerts), production only: where they go, comma-separated; empty uses MADANI_ADMIN_EMAILS
MADANI_ALERT_EMAILS=
# 1 emails the alert addresses every new bug report from the apps; unset keeps them in the admin panel only
MADANI_BUG_REPORT_MAIL=
# off stops those emails; incidents are still kept for GET /v1/admin/incidents
MADANI_ALERTS=

# --- sign-in providers (optional; setting any name of a provider requires all of its required ones) ---
# Google: OAuth client for https://madani.bot/v1/auth/oauth/google/callback (and https://preview.madani.bot/... for staging)
MADANI_AUTH_GOOGLE_CLIENT_ID=
MADANI_AUTH_GOOGLE_CLIENT_SECRET=
# Apple: Services ID, team, key id and the .p8 key (inline with \n, or a 0600 file path)
MADANI_AUTH_APPLE_CLIENT_ID=
MADANI_AUTH_APPLE_TEAM_ID=
MADANI_AUTH_APPLE_KEY_ID=
MADANI_AUTH_APPLE_PRIVATE_KEY=
MADANI_AUTH_APPLE_PRIVATE_KEY_FILE=
# the phone app's bundle ids, comma-separated, for native Sign in with Apple
MADANI_AUTH_APPLE_NATIVE_CLIENT_IDS=

# --- billing (Dodo Payments, merchant of record) ---
# dodo in production; empty means billing off (plans cannot be bought)
MADANI_BILLING_PROVIDER=
# test on staging, live on production
MADANI_DODO_MODE=
# Dodo API key for that mode
MADANI_DODO_API_KEY=
# webhook signing secret for https://madani.bot/v1/billing/webhooks/dodo (whsec_...)
MADANI_DODO_WEBHOOK_SECRET=
# JSON map of keys to Dodo ids, single-quoted (the file is sourced by a shell). 28 keys, each in :month and :year
# (plans.ts DODO_PRODUCT_KEYS): plan_pro and plan_team (a whole plan as ONE product at its full price: $50 and $119 a month),
# subscription products license_solo, license_team, desktop_shared_s, desktop_shared_m,
# desktop_dedicated; add-ons addon_member, addon_shared_s, addon_shared_m, addon_dedicated, addon_vcpu, addon_ram_gb,
# addon_disk_20gb ($1/mo or $10/yr per 20 GB). scripts/dodo-plan-products.ts creates the plan products. a missing key is logged at boot and its carts answer 503
MADANI_DODO_PRODUCTS=
# optional: until this ISO date work use is free (launch promotion)
MADANI_FREE_WORK_UNTIL=
# Ed25519 key that signs plan entitlements (kid:<pkcs8 base64url>; apps/cloud-service/scripts/keygen.mjs); its public half is pinned in shared/entitlement.ts
MADANI_ENTITLEMENT_SIGNING_KEY=
# signs link grants (POST /v1/app/link-grant) the link service requires to open a VPS setup session; unset uses
# MADANI_ENTITLEMENT_SIGNING_KEY, whose public half the link service pins. without either, linking a server is off.
MADANI_LINK_GRANT_SIGNING_KEY=

# --- cloud desktops (optional) ---
# 1 attaches the managed cloud (apps/cloud-service); needs the names below
MADANI_MANAGED=
# days a cloud and its data are kept asleep after its plan ends or its account is deleted (default and minimum 30)
MADANI_MANAGED_RETENTION_DAYS=
# runtime key of the cloud desktop provider (InstaBox); only this service holds it
INSTABOX_API_KEY=
# provider API base override (tests and staging only)
INSTABOX_BASE_URL=
# provider plan whose starts a minute the policy plans for: pro (default), builder or team
MADANI_MANAGED_PROVIDER_PLAN=
# the provider template a new machine starts from (default universal)
MADANI_MANAGED_PROVIDER_TEMPLATE=
# minutes the provider pauses a machine by itself once our activity lease lapses (5 to 30, default 30)
MADANI_MANAGED_IDLE_PAUSE_MINUTES=
# sealing key for cloud bootstrap secrets, link keys and Slack edge tokens at rest (base64url 32 bytes)
MADANI_CLOUD_SEAL_KEY=
# key that seals cloud backups; derived from MADANI_CLOUD_SEAL_KEY when empty; _PREVIOUS opens backups made before a rotation
MADANI_MANAGED_BACKUP_KEY=
MADANI_MANAGED_BACKUP_KEY_PREVIOUS=
# folder for sealed cloud backups (default <data>/managed-backups)
MADANI_MANAGED_BACKUP_DIR=
# optional tuning, each with a default (apps/cloud-service/.env.example says what each does)
MADANI_MANAGED_BACKUP_HOURS=
MADANI_MANAGED_BACKUP_KEEP=
MADANI_MANAGED_BACKUP_MAX_MB=
MADANI_MANAGED_BACKUP_TAIL_DAYS=
MADANI_MANAGED_DELETE_DELAY_DAYS=
MADANI_MANAGED_IDLE_MINUTES=
MADANI_MANAGED_LEASE_HOURS=
MADANI_MANAGED_WAKE_LEAD_MINUTES=
MADANI_MANAGED_EDGE_WAKES_PER_HOUR=
MADANI_MANAGED_LOST_AFTER_MINUTES=
# shared with the public edge Worker (EDGE_TOKEN) for its route lookup
MADANI_MANAGED_EDGE_TOKEN=
# public name suffix of cloud desktops, e.g. cloud.madani.bot
MADANI_MANAGED_PUBLIC_DOMAIN=
# desktop kinds offered (default shared_s,shared_m,dedicated)
MADANI_MANAGED_KINDS=
# provider label scope that marks our machines (default from the public URL)
MADANI_MANAGED_SCOPE=
# the home package a machine installs: URL or file, its sha256 and release signature (inline or file)
MADANI_MANAGED_HOME_PACKAGE_URL=
MADANI_MANAGED_HOME_PACKAGE_FILE=
MADANI_MANAGED_HOME_PACKAGE_SHA256=
MADANI_MANAGED_HOME_PACKAGE_SIGNATURE=
MADANI_MANAGED_HOME_PACKAGE_SIGNATURE_FILE=
# extra release public keys (kid:x,...) for staging builds; empty in production
MADANI_RELEASE_PUBLIC_KEYS=
# the newest home release on offer ({ sha256, signature, url | file, clouds? }) and the signed update policy (floor,
# blocked versions, paused, rollout); scripts/release-all.ts writes both: <home dir>/release.json, <home dir>/update-policy.json
MADANI_MANAGED_HOME_RELEASE_FILE=
MADANI_UPDATE_POLICY_FILE=
# 1 only for the e2e harness against .test/.invalid hosts
MADANI_MANAGED_TEST_HARNESS=
# dedicated desktops on another provider: hetzner plus its API token; fake only on loopback
MADANI_CLOUD_PROVIDER=
MADANI_HETZNER_TOKEN=
# the cloud desktop image and public origin template, e.g. https://{id}.cloud.madani.bot
MADANI_CLOUD_HOME_IMAGE=
MADANI_CLOUD_ORIGIN_TEMPLATE=
# shared pool desktops: fake only on loopback; empty in production until a pool driver exists
MADANI_POOL_DRIVER=
# 1 lets sleeping cloud desktops keep their Slack bots (needs MADANI_CLOUD_SEAL_KEY)
MADANI_SLACK_EDGE=

# --- published pages (optional) ---
# store: off (default), fs, memory or s3; the pages' own domain (default page.madani.bot)
MADANI_PAGES_STORE=
MADANI_PAGES_DOMAIN=
MADANI_PAGES_S3_ENDPOINT=
MADANI_PAGES_S3_REGION=
MADANI_PAGES_S3_BUCKET=
MADANI_PAGES_S3_ACCESS_KEY_ID=
MADANI_PAGES_S3_SECRET_ACCESS_KEY=
# days of free trial before a cloud plan charges; unset or 0 means no trial
MADANI_TRIAL_DAYS=
