# copy to ~/.config/dusk-seo.env (chmod 600). names only here; the values are yours
DUSK_SEO_REPO=/code/deployd
DUSK_REPO=/code/OpenMausBot
SITE_URL=https://dusk.bot
# the command that ships sites/dusk after a release (empty: commit and push only)
DUSK_SEO_DEPLOY=
# search console: a service account json key (added as a user on the property) and the property name
DUSK_GSC_CREDENTIALS=/home/agent/.config/dusk-gsc.json
DUSK_GSC_SITE=sc-domain:dusk.bot
