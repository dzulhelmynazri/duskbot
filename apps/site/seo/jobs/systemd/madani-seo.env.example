# copy to ~/.config/madani-seo.env (chmod 600). names only here; the values are yours
MADANI_SEO_REPO=/code/deployd
MADANI_REPO=/code/OpenMausBot
SITE_URL=https://madani.bot
# the command that ships sites/madani after a release (empty: commit and push only)
MADANI_SEO_DEPLOY=
# search console: a service account json key (added as a user on the property) and the property name
MADANI_GSC_CREDENTIALS=/home/agent/.config/madani-gsc.json
MADANI_GSC_SITE=sc-domain:madani.bot
