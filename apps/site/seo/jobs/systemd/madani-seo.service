# the seo system's daily run, as a systemd user service (see omb-ref/SEO-SYSTEM.md "run it every day")
[Unit]
Description=madani.bot seo: release gate, build, indexnow
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/madani-seo.env
ExecStart=/bin/bash -lc '"$MADANI_SEO_REPO/sites/madani/seo/jobs/daily.sh"'
