# landing site (server.js landing) env. real values: the [landing] part of ~/.config/madanibot/madani.env (NAME_LANDING), uploaded by deploy.sh
# waitlist store: mongodb when MONGODB_URI is set, else a jsonl file at MADANI_WAITLIST_FILE (keep it outside the app folder)
MONGODB_URI=mongodb://madani:<password>@127.0.0.1:29018/madani?authSource=admin
MONGODB_DB=madani
MADANI_WAITLIST_FILE=/root/madani-data/waitlist.jsonl
# new signups are added to this brevo list (key needs the contacts permission; list id from brevo-setup.mjs)
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
# signs the unsubscribe links in news emails (unsubscribe.js); any long random string, the send script uses the same one
MADANI_UNSUBSCRIBE_SECRET=
