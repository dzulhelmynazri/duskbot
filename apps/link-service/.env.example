# link service (npm start). names only; set values in the deploy env file, never in the repo.
PORT=8790
HOST=127.0.0.1
LINK_BASE=https://link.madani.bot
LINK_DATA_DIR=
LINK_PACKAGES_DIR=
LINK_TRUST_PROXY=1
# advertised at /.well-known/madanibot/dashboard
MADANI_LINK_DASHBOARD_URL=
# link grants: unset trusts the pinned account service key; MADANI_LINK_OPEN=1 drops the account check (development only)
MADANI_LINK_GRANT_KEYS=
MADANI_LINK_OPEN=
# phone push relay (docs/phone-push.md); unset means that service is off
MADANI_APNS_KEY_FILE=
MADANI_APNS_KEY_ID=
MADANI_APNS_TEAM_ID=
MADANI_APNS_TOPIC=
MADANI_FCM_SERVICE_ACCOUNT_FILE=
